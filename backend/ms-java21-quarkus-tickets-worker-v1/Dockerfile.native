# syntax=docker/dockerfile:1

# ---------------------------------------------------------------------------
# Build nativo del worker de tickets.
# Pensado para el publisher nativo de GitHub Actions, no para docker-compose
# (en compose el worker se construye con el Dockerfile JVM).
# ---------------------------------------------------------------------------
FROM quay.io/quarkus/ubi9-quarkus-mandrel-builder-image:jdk-25 AS build

USER quarkus
WORKDIR /project

# Cache de dependencias Maven.
COPY --chown=quarkus:quarkus .mvn/ .mvn/
COPY --chown=quarkus:quarkus mvnw pom.xml ./
RUN chmod +x mvnw \
    && ./mvnw -B -ntp -q dependency:go-offline

COPY --chown=quarkus:quarkus src ./src

# Compila el ejecutable nativo (sin JVM).
RUN ./mvnw -B -ntp -q package -Dnative -DskipTests

# ---------------------------------------------------------------------------
# Imagen final mínima, solo con el binario nativo y el management en :9000.
# ---------------------------------------------------------------------------
FROM quay.io/quarkus/ubi9-quarkus-micro-image:2.0

WORKDIR /work/
RUN chown 1001 /work \
    && chmod "g+rwX" /work \
    && chown 1001:root /work

COPY --from=build --chown=1001:root --chmod=0755 /project/target/*-runner /work/application

EXPOSE 9000
USER 1001

ENTRYPOINT ["./application"]
