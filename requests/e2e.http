# FLUJO REAL COMPLETO vía gateway. Variables manuales: corre cada paso y
# pega los ids donde se indica. Compatible con cualquier cliente HTTP.
# El paso 7 es async (mensajería): si sale [], espera unos segundos y reenvía.
@baseUrl = http://localhost:8080
@password = 123456
@eventoId = 1
@ordenId = PEGAR_ID_DE_LA_ORDEN_DEL_PASO_4
@ticketId = PEGAR_ID_DE_UN_TICKET_DEL_PASO_6

### 1. Registrar comprador (debe dar 201; si da 409 el email ya existe, usa otro)
POST {{baseUrl}}/api/auth/registro
Content-Type: application/json

{
  "nombre": "Usuario E2E",
  "email": "e2e@test.com",
  "password": "{{password}}",
  "rol": "COMPRADOR"
}

### 2. Login (debe dar 200 con token; anota el id del usuario para @compradorId)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "e2e@test.com",
  "password": "{{password}}"
}

### 3. Crear evento con 2 tipos (debe dar 201)
POST {{baseUrl}}/api/eventos
Content-Type: application/json

{
  "nombre": "Festival E2E",
  "descripcion": "Flujo real completo",
  "fecha": "2026-12-20T20:00:00",
  "lugar": "Arena",
  "aforoTotal": 10,
  "tiposEntrada": [
    { "nombre": "General", "precio": 15000 },
    { "nombre": "VIP", "precio": 35000 }
  ]
}

### 4. Crear orden multi-item 2 General + 1 VIP (debe dar 202 PENDIENTE_EMISION)
POST {{baseUrl}}/api/v1/ordenes
Content-Type: application/json

{
  "eventoId": {{eventoId}},
  "compradorId": 10,
  "items": [
    { "tipoEntradaId": 1, "cantidad": 2 },
    { "tipoEntradaId": 2, "cantidad": 1 }
  ]
}

### 5. Ver orden (200; primero PENDIENTE, luego EMITIDA con ticketIds)
GET {{baseUrl}}/api/v1/ordenes/{{ordenId}}

### 6. Tickets por orden (200 con 3 tickets)
GET {{baseUrl}}/api/v1/tickets/por-orden/{{ordenId}}

### 7. Ticket por id (200, EMITIDO con codigo UUID)
GET {{baseUrl}}/api/v1/tickets/{{ticketId}}

### 8. Orden EMITIDA con sus 3 ticketIds (200)
GET {{baseUrl}}/api/v1/ordenes/{{ordenId}}

### 9. Evento con aforo descontado en 3 (200)
GET {{baseUrl}}/api/eventos/{{eventoId}}

### 10. Sin stock (409 ORD-409)
POST {{baseUrl}}/api/v1/ordenes
Content-Type: application/json

{
  "eventoId": {{eventoId}},
  "compradorId": 10,
  "items": [
    { "tipoEntradaId": 1, "cantidad": 1000 }
  ]
}

### 11. Evento inexistente (404 ORD-404)
POST {{baseUrl}}/api/v1/ordenes
Content-Type: application/json

{
  "eventoId": 999999,
  "compradorId": 10,
  "items": [
    { "tipoEntradaId": 1, "cantidad": 1 }
  ]
}

### 12. Items vacíos (400)
POST {{baseUrl}}/api/v1/ordenes
Content-Type: application/json

{
  "eventoId": {{eventoId}},
  "compradorId": 10,
  "items": []
}

### 13. Orden inexistente (404 ORD-404)
GET {{baseUrl}}/api/v1/ordenes/000000000000000000000000

### 14. Ticket inexistente (404 TIC-404)
GET {{baseUrl}}/api/v1/tickets/000000000000000000000000

### 15. Login malo (401)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "e2e@test.com",
  "password": "clave-mala"
}
