# Prueba completa vía gateway. Corre de arriba hacia abajo, sin pegar ids.
@baseUrl = http://localhost:8080
@cantidad = 5

# @name crearEvento
### 1. Crear evento con tipos de entrada (debe dar 201)
POST {{baseUrl}}/api/eventos
Content-Type: application/json

{
  "nombre": "Concierto Rock en Chile",
  "descripcion": "Festival de bandas nacionales",
  "fecha": "2026-12-20T20:00:00",
  "lugar": "Movistar Arena",
  "aforoTotal": 100,
  "tiposEntrada": [
    { "nombre": "General", "precio": 15000 },
    { "nombre": "VIP", "precio": 35000 }
  ]
}

### 2. Listar eventos (debe dar 200)
GET {{baseUrl}}/api/eventos

### 3. Buscar evento por id (debe dar 200)
GET {{baseUrl}}/api/eventos/{{crearEvento.response.body.$.id}}

### 4. Reservar cupo (debe dar reservado=true)
POST {{baseUrl}}/api/eventos/{{crearEvento.response.body.$.id}}/reservar
Content-Type: application/json

{
  "cantidad": {{cantidad}}
}

### 5. Reservar cupo que excede el aforo (debe dar reservado=false)
POST {{baseUrl}}/api/eventos/{{crearEvento.response.body.$.id}}/reservar
Content-Type: application/json

{
  "cantidad": 1000
}

### 6. Actualizar evento (debe dar 200 con los cambios)
PUT {{baseUrl}}/api/eventos/{{crearEvento.response.body.$.id}}
Content-Type: application/json

{
  "nombre": "Concierto Rock en Chile (editado)",
  "descripcion": "Festival de bandas nacionales",
  "fecha": "2026-12-20T20:00:00",
  "lugar": "Movistar Arena",
  "aforoTotal": 100,
  "tiposEntrada": [
    { "nombre": "General", "precio": 15000 },
    { "nombre": "VIP", "precio": 35000 }
  ]
}

### 7. Eliminar evento (debe dar 204)
DELETE {{baseUrl}}/api/eventos/{{crearEvento.response.body.$.id}}

### 8. Buscar evento eliminado (debe dar 404)
GET {{baseUrl}}/api/eventos/{{crearEvento.response.body.$.id}}

### 9. Buscar evento inexistente (debe dar 404)
GET {{baseUrl}}/api/eventos/999999

### 10. Crear evento con fecha pasada (debe dar 400)
POST {{baseUrl}}/api/eventos
Content-Type: application/json

{
  "nombre": "Evento invalido",
  "fecha": "2020-01-01T10:00:00",
  "lugar": "Test",
  "aforoTotal": 10
}
