# Copia a .env en infra/docker/ y ajusta. Compose lee .env junto al yml.
SERVER_PORT=8080

# Mongo (contenedor "mongodb" dentro de compose, localhost fuera de compose)
MONGO_PORT=27017
MONGO_DATABASE=eventpass_ordenes
SPRING_DATA_MONGODB_URI=mongodb://mongodb:27017/eventpass_ordenes

# RabbitMQ
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest
