# Copia a .env en la raiz y ajusta. Compose lee .env junto al yml.
# Ordenes (Mongo + Rabbit)
SERVER_PORT=8080

# Mongo (solo red interna, sin puerto publicado)
MONGO_PORT=27017
MONGO_DATABASE=eventpass_ordenes
SPRING_DATA_MONGODB_URI=mongodb://ordenes-mongo:27017/eventpass_ordenes

# RabbitMQ (solo red interna, sin puerto publicado)
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest

# Eventos (nombre DNS dentro de la red de compose, puerto interno 8080)
EVENTOS_SERVICE_URL=http://eventos-service:8080

# Gateway (único puerto publicado al host; los servicios solo hablan por la red interna)
GATEWAY_PORT=8080
ORDENES_SERVICE_URL=http://ordenes-service:8080
AUTH_SERVICE_URL=http://bff-auth-service:8080

# BFF Auth (Postgres "postgres-auth", solo red interna)
AUTH_DB_PORT=5432
AUTH_DB_NAME=eventpass_auth
AUTH_DB_USER=postgres
AUTH_DB_PASSWORD=postgres
JWT_SECRET=eventpass-super-secret-key-para-el-ramo-jvy0101-cambiar-en-produccion
JWT_EXPIRATION_MS=3600000

# Eventos (Postgres "postgres-eventos", solo red interna)
EVENTOS_DB_PORT=5433
EVENTOS_DB_NAME=eventpass_eventos
EVENTOS_DB_USER=postgres
EVENTOS_DB_PASSWORD=postgres
