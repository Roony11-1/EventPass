# Copia a .env en la raiz y ajusta. Compose lee .env junto al yml.
# Ordenes (Mongo + Rabbit)
SERVER_PORT=8080

# Mongo (contenedor "mongodb" dentro de compose, localhost fuera de compose)
MONGO_PORT=27017
MONGO_DATABASE=eventpass_ordenes
SPRING_DATA_MONGODB_URI=mongodb://mongodb:27017/eventpass_ordenes

# RabbitMQ
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest

# BFF Auth (Postgres "postgres-auth" dentro de compose)
# BFF_AUTH_PORT = puerto host (el contenedor expone 8080)
BFF_AUTH_PORT=8081
AUTH_DB_PORT=5432
AUTH_DB_NAME=eventpass_auth
AUTH_DB_USER=postgres
AUTH_DB_PASSWORD=postgres
JWT_SECRET=eventpass-super-secret-key-para-el-ramo-jvy0101-cambiar-en-produccion
JWT_EXPIRATION_MS=3600000

# Eventos (Postgres "postgres-eventos" dentro de compose)
# EVENTOS_PORT = puerto host (el contenedor expone 8080)
EVENTOS_PORT=8082
EVENTOS_DB_PORT=5433
EVENTOS_DB_NAME=eventpass_eventos
EVENTOS_DB_USER=postgres
EVENTOS_DB_PASSWORD=postgres
